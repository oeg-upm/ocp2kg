            sh:path :isSubmittedForLot ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is submited by" ;
            sh:path :isSubmitedBy ],
        [ a sh:PropertyShape ;
            sh:class :LotGroup ;
            sh:name "Is subject to grouping" ;
            sh:path :isSubjectToGrouping ],
        [ a sh:PropertyShape ;
            sh:class :SubcontractingEstimate ;
            sh:name "Foresees subcontracting" ;
