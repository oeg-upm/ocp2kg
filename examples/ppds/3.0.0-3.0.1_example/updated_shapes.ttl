            sh:name "Has fixed value" ;
            sh:path :hasFixedValue ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has award criterion type" ;
            sh:path :hasAwardCriterionType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has fixed value" ;
            sh:path :hasFixedValue ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasFixedValueType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasFixedValueType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAwardCriterionType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAwardCriterionType> ?this .}" ] ;
    sh:targetClass :AwardCriterion .

:Business a sh:NodeShape ;
