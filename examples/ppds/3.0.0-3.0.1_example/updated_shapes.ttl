:ProcedureTerm a sh:NodeShape ;
    rdfs:label "Procedure term"@en ;
    rdfs:comment """Conditions and stipulations defining particularities of the procedure.

(WG approval 23/11/2018)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Conditions and stipulations defining particularities of the procedure.

(WG approval 23/11/2018)""" ;
    sh:name "Procedure term" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :LotGroup ;
            sh:name "Defines lot group" ;
            sh:path :definesLotGroup ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines budget provider" ;
            sh:path :definesBudgetProvider ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:name "Has lot award limit" ;
            sh:path :hasLotAwardLimit ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:name "Has receipt expressions deadline" ;
            sh:path :hasReceiptExpressionsDeadline ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is awarded by c p b" ;
            sh:path :isAwardedByCPB ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has lot award limit" ;
            sh:path :hasLotAwardLimit ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has group lot evaluation method" ;
            sh:path :hasGroupLotEvaluationMethod ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has cross border law" ;
            sh:path :hasCrossBorderLaw ],
        [ a sh:PropertyShape ;
            sh:class :BudgetProvider ;
            sh:name "Defines budget provider" ;
            sh:path :definesBudgetProvider ],
        [ a sh:PropertyShape ;
            sh:class :TertiaryRole ;
            sh:name "Defines information provider" ;
            sh:path :definesInformationProvider ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has estimated tender invitation date" ;
            sh:path :hasEstimatedTenderInvitationDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has receipt expressions deadline" ;
            sh:path :hasReceiptExpressionsDeadline ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has estimated tender invitation date" ;
            sh:path :hasEstimatedTenderInvitationDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines mediator" ;
            sh:path :definesMediator ],
        [ a sh:PropertyShape ;
            sh:class :Mediator ;
            sh:name "Defines mediator" ;
            sh:path :definesMediator ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is awarded by c p b" ;
            sh:path :isAwardedByCPB ],
        <http://myexampleuri.org/data#hasQualificationSystemDurationShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesMediator> ?that . ?that <http://data.europa.eu/a4g/ontology#definesMediator> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesLotGroup> ?that . ?that <http://data.europa.eu/a4g/ontology#definesLotGroup> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesInformationProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#definesInformationProvider> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesBudgetProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#definesBudgetProvider> ?this .}" ] ;
    sh:targetClass :ProcedureTerm .

:ProcessPlanningTerm a sh:NodeShape ;
    rdfs:label "Process planning term"@en ;
