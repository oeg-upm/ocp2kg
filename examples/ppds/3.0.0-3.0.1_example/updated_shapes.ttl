WG approval 31/10/2018""" ;
    sh:name "Selection criterion" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is used for candidate restriction" ;
            sh:path :isUsedForCandidateRestriction ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has selection criterion type" ;
            sh:path :hasSelectionCriterionType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has selection criteria usage" ;
            sh:path :hasSelectionCriteriaUsage ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is used for candidate restriction" ;
            sh:path :isUsedForCandidateRestriction ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasSelectionCriteriaUsage> ?that . ?that <http://data.europa.eu/a4g/ontology#hasSelectionCriteriaUsage> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasSelectionCriterionType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasSelectionCriterionType> ?this .}" ] ;
    sh:targetClass :SelectionCriterion .

:Tenderer a sh:NodeShape ;
    rdfs:label "Tenderer"@en ;
    rdfs:comment """A role of an agent that has submitted a tender.

Additional Information:
A tenderer is an economic operator or group of economic operators that has submitted a tender.
WG approval 05/08/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A role of an agent that has submitted a tender.

Additional Information:
A tenderer is an economic operator or group of economic operators that has submitted a tender.
WG approval 05/08/2021""" ;
    sh:name "Tenderer" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :ExclusionGround ;
            sh:name "Substantiates exclusion ground" ;
            sh:path :substantiatesExclusionGround ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Substantiates exclusion ground" ;
            sh:path :substantiatesExclusionGround ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#substantiatesExclusionGround> ?that . ?that <http://data.europa.eu/a4g/ontology#substantiatesExclusionGround> ?this .}" ] ;
    sh:targetClass :Tenderer .

:Winner a sh:NodeShape ;
    rdfs:label "Winner"@en ;
    rdfs:comment """A role of an agent to whom a lot is awarded.
WG approval 05/08/2021 (revised 26/10/2021)"""@en ;
