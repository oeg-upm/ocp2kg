            sh:path :hasFrameworkAgreementEstimatedValue ],
        [ a sh:PropertyShape ;
            sh:class :MonetaryValue ;
            sh:name "Has framework agreement maximum value" ;
            sh:path :hasFrameworkAgreementMaximumValue ],
        [ a sh:PropertyShape ;
            sh:class :MonetaryValue ;
            sh:name "Has awarded value" ;
            sh:path :hasAwardedValue ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has awarded value" ;
            sh:path :hasAwardedValue ],
        [ a sh:PropertyShape ;
            sh:class :MonetaryValue ;
            sh:name "Has framework agreement estimated value" ;
            sh:path :hasFrameworkAgreementEstimatedValue ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has award decision date" ;
            sh:path :hasAwardDecisionDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has additional non award justification" ;
            sh:path :hasAdditionalNonAwardJustification ],
        [ a sh:PropertyShape ;
            sh:class :TenderAwardOutcome ;
            sh:name "Comprises tender award outcome" ;
            sh:path :comprisesTenderAwardOutcome ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has additional non award justification" ;
            sh:path :hasAdditionalNonAwardJustification ],
        [ a sh:PropertyShape ;
            sh:class :Buyer ;
            sh:name "Is adopted by buyer" ;
            sh:path :isAdoptedByBuyer ],
        <http://myexampleuri.org/data#hasBuyerLegalTypeShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasFrameworkAgreementMaximumValue> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isAdoptedByBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#isAdoptedByBuyer> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesTenderAwardOutcome> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAwardedValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAwardedValue> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAwardStatus> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAwardStatus> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasFrameworkAgreementEstimatedValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasFrameworkAgreementEstimatedValue> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#describesLot> ?that . ?that <http://data.europa.eu/a4g/ontology#describesLot> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAwardedEstimatedValue> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAwardedEstimatedValue> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNonAwardJustification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNonAwardJustification> ?this .}" ] ;
    sh:targetClass :LotAwardOutcome .

:Purpose a sh:NodeShape ;
    rdfs:label "Purpose"@en ;
    rdfs:comment """The description of the objectives related to a procurement. 

Additional information:

The description of the objectives includes the subject matter and quantities.


The quantification of the objectives related to a procurement.

To be re-reviewed by the WG the soonest.

(WG to be discussed, this was pointed out on the 09/04/2019 14:38:25 WG Meeting)

The old definition read as follows:

The description of the objectives related to a procurement.

(WG approval 05/12/2018)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """The description of the objectives related to a procurement. 

Additional information:

The description of the objectives includes the subject matter and quantities.


The quantification of the objectives related to a procurement.

To be re-reviewed by the WG the soonest.

(WG to be discussed, this was pointed out on the 09/04/2019 14:38:25 WG Meeting)

The old definition read as follows:

The description of the objectives related to a procurement.

(WG approval 05/12/2018)""" ;
    sh:name "Purpose" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :Quantity ;
            sh:name "Has total quantity" ;
            sh:path :hasTotalQuantity ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Has main classification" ;
            sh:path :hasMainClassification ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has contract nature type" ;
            sh:path :hasContractNatureType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has total quantity" ;
            sh:path :hasTotalQuantity ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasContractNatureType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasContractNatureType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasMainClassification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasMainClassification> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAdditionalClassification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAdditionalClassification> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasAdditionalContractNature> ?that . ?that <http://data.europa.eu/a4g/ontology#hasAdditionalContractNature> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTotalQuantity> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTotalQuantity> ?this .}" ] ;
    sh:targetClass :Purpose .

:TechniqueUsage a sh:NodeShape ;
    rdfs:label "Technique usage"@en ;
    rdfs:comment """Methods used for conducting procurement procedure.

Addtional information:
This corresponds in eForms to BG-706 Techniques.

Several techniques can be combined in one single procurement procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS).

WG Approval 19/09/2019"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Methods used for conducting procurement procedure.

Addtional information:
This corresponds in eForms to BG-706 Techniques.

Several techniques can be combined in one single procurement procedure (e.g. eAuction can be carried out in a Framework Agreement or DPS).

WG Approval 19/09/2019""" ;
    sh:name "Technique usage" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :Period ;
            sh:name "Has validity period" ;
            sh:path :hasValidityPeriod ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has usage" ;
            sh:path :hasUsage ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has validity period" ;
            sh:path :hasValidityPeriod ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has description" ;
            sh:path :hasDescription ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasUsage> ?that . ?that <http://data.europa.eu/a4g/ontology#hasUsage> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasValidityPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#hasValidityPeriod> ?this .}" ] ;
    sh:targetClass :TechniqueUsage .

dcterms:Location a sh:NodeShape ;
    rdfs:label "Location"@en ;
    rdfs:comment "An identifiable geographic place or named place."@en ;
    sh:description "An identifiable geographic place or named place." ;
    sh:name "Location" ;
    sh:property [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Geometry> ;
            sh:name "Geometry" ;
            sh:path :geometry ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has nuts code" ;
            sh:path :hasNutsCode ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Geographic name" ;
            sh:path <http://www.w3.org/ns/locn#geographicName> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Geographic name" ;
            sh:path <http://www.w3.org/ns/locn#geographicName> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has country code" ;
            sh:path :hasCountryCode ],
        [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:name "Address" ;
            sh:path :address ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Address" ;
            sh:path :address ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Geographic identifier" ;
            sh:path :geographicIdentifier ],
        [ a sh:PropertyShape ;
            sh:class :Identifier ;
            sh:name "Geographic identifier" ;
            sh:path :geographicIdentifier ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Geometry" ;
            sh:path :geometry ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#geometry> ?that . ?that <http://data.europa.eu/a4g/ontology#geometry> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasCountryCode> ?that . ?that <http://data.europa.eu/a4g/ontology#hasCountryCode> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNutsCode> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNutsCode> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#address> ?that . ?that <http://data.europa.eu/a4g/ontology#address> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#geographicIdentifier> ?that . ?that <http://data.europa.eu/a4g/ontology#geographicIdentifier> ?this .}" ] ;
    sh:targetClass dcterms:Location .

<http://unknown.domain/for/prefix#Channel> a sh:NodeShape ;
    rdfs:label "Channel"@en ;
    rdfs:comment """A medium through which an Agent provides, uses or interacts in another way with a Public Service. Typical examples include online services, phone, walk-in centres etc.

Additional Information
Software solutions and electronic devices for communication and exchange of information between buyers and economic operators.
Lots may use ad-hoc electronic means of communication that are not generally available such as specific solutions for secure and dedicated communication or non-standard eCatalogues.

See also Directive recitals 53 to 56.

WG Suggestion to eForms 30/09/2019"""@en ;
    sh:description """A medium through which an Agent provides, uses or interacts in another way with a Public Service. Typical examples include online services, phone, walk-in centres etc.

Additional Information
Software solutions and electronic devices for communication and exchange of information between buyers and economic operators.
Lots may use ad-hoc electronic means of communication that are not generally available such as specific solutions for secure and dedicated communication or non-standard eCatalogues.

See also Directive recitals 53 to 56.

WG Suggestion to eForms 30/09/2019""" ;
    sh:name "Channel" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has additional information" ;
            sh:path :hasAdditionalInformation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has endpoint" ;
            sh:path :hasEndpoint ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has name" ;
            sh:path :hasName ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has u r l" ;
            sh:path :hasURL ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has description" ;
            sh:path :hasDescription ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is adhoc channel" ;
            sh:path :isAdhocChannel ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has endpoint" ;
            sh:path :hasEndpoint ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has u r l" ;
            sh:path :hasURL ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is adhoc channel" ;
            sh:path :isAdhocChannel ] ;
    sh:targetClass <http://unknown.domain/for/prefix#Channel> .

org:Organization a sh:NodeShape ;
    rdfs:label "Organization"@en ;
    rdfs:comment """A collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organisations are often decomposable into hierarchical structures.

(WG approval 23/11/2018)."""@en ;
    sh:description """A collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organisations are often decomposable into hierarchical structures.

(WG approval 23/11/2018).""" ;
    sh:name "Organization" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has legal name" ;
            sh:path :hasLegalName ],
        [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:name "Address" ;
            sh:path :address ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has legal form type" ;
            sh:path :hasLegalFormType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Registered address" ;
            sh:path :registeredAddress ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has legal name" ;
            sh:path :hasLegalName ],
        [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:name "Registered address" ;
            sh:path :registeredAddress ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has legal type" ;
            sh:path :hasLegalType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has legal form type" ;
            sh:path :hasLegalFormType ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has organisation unit" ;
            sh:path :hasOrganisationUnit ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has delivery gateway" ;
            sh:path :hasDeliveryGateway ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has organisation unit" ;
            sh:path :hasOrganisationUnit ],
        [ a sh:PropertyShape ;
            sh:class <http://unknown.domain/for/prefix#Channel> ;
            sh:name "Has delivery gateway" ;
            sh:path :hasDeliveryGateway ],
        [ a sh:PropertyShape ;
            sh:class <http://data.europa.eu/m8g/ContactPoint> ;
            sh:name "Has primary contact point" ;
            sh:path :hasPrimaryContactPoint ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has main activity type" ;
            sh:path :hasMainActivityType ],
        <http://myexampleuri.org/data#hasMainActivityShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLegalType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLegalType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#registeredAddress> ?that . ?that <http://data.europa.eu/a4g/ontology#registeredAddress> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasDeliveryGateway> ?that . ?that <http://data.europa.eu/a4g/ontology#hasDeliveryGateway> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasMainActivityType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasMainActivityType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPrimaryContactPoint> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPrimaryContactPoint> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#address> ?that . ?that <http://data.europa.eu/a4g/ontology#address> ?this .}" ] ;
    sh:targetClass org:Organization .

:Duration a sh:NodeShape ;
    rdfs:label "Duration"@en ;
    rdfs:comment "The length of time in which a concept occurs."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "The length of time in which a concept occurs." ;
    sh:name "Duration" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Numeric duration" ;
            sh:path time:numericDuration ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:name "Numeric duration" ;
            sh:path time:numericDuration ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Unit type" ;
            sh:path :unitType ],
        <http://myexampleuri.org/data#refersToProcedureShape> ;
