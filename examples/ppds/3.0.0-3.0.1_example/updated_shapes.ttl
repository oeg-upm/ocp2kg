    sh:targetClass :ElementDescription .

:ElementModificationDescription a sh:NodeShape ;
    rdfs:label "Element modification description"@en ;
    rdfs:comment "Information about a specific field to be changed with regard to the modification of a contract."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
