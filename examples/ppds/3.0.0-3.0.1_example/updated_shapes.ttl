        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has contact name" ;
            sh:path :hasContactName ],
        [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:name "Address" ;
            sh:path :address ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Email" ;
            sh:path <http://data.europa.eu/m8g/email> ],
        [ a sh:PropertyShape ;
