    sh:description """A role of an agent to whom a lot is awarded.
WG approval 05/08/2021 (revised 26/10/2021)""" ;
    sh:name "Winner" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on tenderer" ;
            sh:path :dependsOnTenderer ],
        [ a sh:PropertyShape ;
            sh:class :Tenderer ;
            sh:name "Depends on tenderer" ;
            sh:path :dependsOnTenderer ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnTenderer> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnTenderer> ?this .}" ] ;
    sh:targetClass :Winner .

:fulfillsRequirement a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
