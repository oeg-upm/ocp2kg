    sh:targetClass :SubcontractingEstimate .

:Subcontractor a sh:NodeShape ;
    rdfs:label "Subcontractor"@en ;
    rdfs:comment """A role of an agent that has an agreement to perform part or all of the obligations of another agents's contract. 
Additional information
For some procedures, the subcontractor signs as well the contract between the buyer and the contractor.

At tendering time, entities relied upon by the economic operators can be subcontractors or not. 

When modelling ESPD we well analyse whether we need or not a role named "relied upon".

WG approval 05/08/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A role of an agent that has an agreement to perform part or all of the obligations of another agents's contract. 
Additional information
For some procedures, the subcontractor signs as well the contract between the buyer and the contractor.

At tendering time, entities relied upon by the economic operators can be subcontractors or not. 

When modelling ESPD we well analyse whether we need or not a role named "relied upon".

WG approval 05/08/2021""" ;
    sh:name "Subcontractor" ;
    sh:targetClass :Subcontractor .

:SubmissionTerm a sh:NodeShape ;
    rdfs:label "Submission term"@en ;
    rdfs:comment """Conditions and stipulations defining particularities of submitting documents to the buyer

Additional Information: 

These documents can be tenders, request to participate and expressions of interest.

WG Approval 14/07/2020"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Conditions and stipulations defining particularities of submitting documents to the buyer

Additional Information: 

These documents can be tenders, request to participate and expressions of interest.

WG Approval 14/07/2020""" ;
    sh:name "Submission term" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has validity period" ;
            sh:path :hasValidityPeriod ],
        [ a sh:PropertyShape ;
            sh:class :TenderProcessor ;
            sh:name "Defines tender processor" ;
            sh:path :definesTenderProcessor ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has non electronic submission description" ;
            sh:path :hasNonElectronicSubmissionDescription ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has late submission permission" ;
            sh:path :hasLateSubmissionPermission ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has e submission permission" ;
            sh:path :hasESubmissionPermission ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:name "Has receipt deadline" ;
            sh:path :hasReceiptDeadline ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has e auction u r l" ;
            sh:path :hasEAuctionURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is guarantee required" ;
            sh:path :isGuaranteeRequired ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is multiple tender submission allowed" ;
            sh:path :isMultipleTenderSubmissionAllowed ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has receipt deadline" ;
            sh:path :hasReceiptDeadline ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has submission u r l" ;
            sh:path :hasSubmissionURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is advanced electronic signature required" ;
            sh:path :isAdvancedElectronicSignatureRequired ],
        [ a sh:PropertyShape ;
            sh:class :TenderReceiver ;
            sh:name "Defines tender receiver" ;
            sh:path :definesTenderReceiver ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is advanced electronic signature required" ;
            sh:path :isAdvancedElectronicSignatureRequired ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is guarantee required" ;
            sh:path :isGuaranteeRequired ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has late submission information description" ;
            sh:path :hasLateSubmissionInformationDescription ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is multiple tender submission allowed" ;
            sh:path :isMultipleTenderSubmissionAllowed ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines tender receiver" ;
            sh:path :definesTenderReceiver ],
        [ a sh:PropertyShape ;
            sh:class :Period ;
            sh:name "Has validity period" ;
            sh:path :hasValidityPeriod ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines tender processor" ;
            sh:path :definesTenderProcessor ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has e catalogue permission" ;
            sh:path :hasECataloguePermission ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has e auction u r l" ;
            sh:path :hasEAuctionURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has variant permission" ;
            sh:path :hasVariantPermission ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has guarantee description" ;
            sh:path :hasGuaranteeDescription ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasValidityPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#hasValidityPeriod> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesTenderReceiver> ?that . ?that <http://data.europa.eu/a4g/ontology#definesTenderReceiver> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasTenderSubcontractingInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#hasTenderSubcontractingInformation> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionJustification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNonElectronicSubmissionJustification> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesTenderProcessor> ?that . ?that <http://data.europa.eu/a4g/ontology#definesTenderProcessor> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasECataloguePermission> ?that . ?that <http://data.europa.eu/a4g/ontology#hasECataloguePermission> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasESubmissionPermission> ?that . ?that <http://data.europa.eu/a4g/ontology#hasESubmissionPermission> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLanguage> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLanguage> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLateSubmissionPermission> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasVariantPermission> ?that . ?that <http://data.europa.eu/a4g/ontology#hasVariantPermission> ?this .}" ] ;
    sh:targetClass :SubmissionTerm .

:System a sh:NodeShape ;
