            sh:path :hasDescription ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasID> ?that . ?that <http://data.europa.eu/a4g/ontology#hasID> ?this .}" ] ;
    sh:targetClass <http://data.europa.eu/m8g/InformationConcept> .

<http://data.europa.eu/m8g/Requirement> a sh:NodeShape ;
    rdfs:label "Requirement"@en ;
    rdfs:comment """Condition or prerequisite that is to be proven by Evidence.

Additional Information:
Requirement is a generic class representing any type of prerequisite that may be desired, needed or imposed as an obligation. CCCEV recommends to not use the Requirement class directly, but rather a more semantically-enriched subclass such as Criterion, Information Requirement or Constraint. Also note that the Requirement class is specified at a more abstract level and is not to be used as the instantiation of a Requirement for a specific Agent.
To illustrate the notion: the European Directive on services in the internal market defines requirement as any obligation, prohibition, condition or limit provided for in the laws, regulations or administrative provisions of the Member States or in consequence of case-law, administrative practice, the rules of professional bodies, or the collective rules of professional associations or other professional organisations, adopted in the exercise of their legal autonomy."""@en ;
    sh:description """Condition or prerequisite that is to be proven by Evidence.

Additional Information:
Requirement is a generic class representing any type of prerequisite that may be desired, needed or imposed as an obligation. CCCEV recommends to not use the Requirement class directly, but rather a more semantically-enriched subclass such as Criterion, Information Requirement or Constraint. Also note that the Requirement class is specified at a more abstract level and is not to be used as the instantiation of a Requirement for a specific Agent.
To illustrate the notion: the European Directive on services in the internal market defines requirement as any obligation, prohibition, condition or limit provided for in the laws, regulations or administrative provisions of the Member States or in consequence of case-law, administrative practice, the rules of professional bodies, or the collective rules of professional associations or other professional organisations, adopted in the exercise of their legal autonomy.""" ;
    sh:name "Requirement" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Name" ;
            sh:path <http://data.europa.eu/m8g/name> ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Description" ;
            sh:path <http://data.europa.eu/m8g/description> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Description" ;
            sh:path <http://data.europa.eu/m8g/description> ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Name" ;
            sh:path <http://data.europa.eu/m8g/name> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Identifier" ;
            sh:path <http://data.europa.eu/m8g/identifier> ],
        [ a sh:PropertyShape ;
            sh:class <http://data.europa.eu/m8g/Requirement> ;
            sh:name "Has requirement" ;
            sh:path :hasRequirement ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Identifier" ;
            sh:path <http://data.europa.eu/m8g/identifier> ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasRequirement> ?that . ?that <http://data.europa.eu/a4g/ontology#hasRequirement> ?this .}" ] ;
    sh:targetClass <http://data.europa.eu/m8g/Requirement> .

foaf:Agent a sh:NodeShape ;
    rdfs:label "Agent"@en ;
    rdfs:comment """A  person, an organization, or a system that acts in procurement or have the power to act in procurement.

WG Approval 28/04/2020"""@en ;
    sh:description """A  person, an organization, or a system that acts in procurement or have the power to act in procurement.

WG Approval 28/04/2020""" ;
    sh:name "Agent" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has name" ;
            sh:path :hasName ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has alias" ;
            sh:path :hasAlias ],
        [ a sh:PropertyShape ;
            sh:class :Identifier ;
            sh:name "Has i d" ;
            sh:path :hasID ],
        [ a sh:PropertyShape ;
            sh:class :System ;
            sh:name "Owns system" ;
            sh:path :ownsSystem ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#ownsSystem> ?that . ?that <http://data.europa.eu/a4g/ontology#ownsSystem> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasID> ?that . ?that <http://data.europa.eu/a4g/ontology#hasID> ?this .}" ] ;
    sh:targetClass foaf:Agent .

:AgentInRole a sh:NodeShape ;
    rdfs:label "Agent in role"@en ;
    rdfs:comment """Relative concept that ties an agent to a part they play in a given situational context.

Additional information:
The classification of roles is based is based on the degree of involvement into the procurement process: 
- Primary (Procurement) role is directly involved in the procurement process;
- Secondary (Procurement sub-)role is secondary to the procurement process
- Tertiary (Related) role is not involved in the procurement process."""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Relative concept that ties an agent to a part they play in a given situational context.

Additional information:
The classification of roles is based is based on the degree of involvement into the procurement process: 
- Primary (Procurement) role is directly involved in the procurement process;
- Secondary (Procurement sub-)role is secondary to the procurement process
- Tertiary (Related) role is not involved in the procurement process.""" ;
    sh:name "Agent in role" ;
    sh:property [ a sh:PropertyShape ;
            sh:class foaf:Agent ;
            sh:name "Played by" ;
            sh:path :playedBy ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Played by" ;
            sh:path :playedBy ],
        [ a sh:PropertyShape ;
            sh:class :AgentInRole ;
            sh:name "Depends on role" ;
            sh:path :dependsOnRole ],
        [ a sh:PropertyShape ;
            sh:class :ProcurementObject ;
            sh:name "Contextualised by" ;
            sh:path :contextualisedBy ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has description" ;
            sh:path :hasDescription ],
        [ a sh:PropertyShape ;
            sh:class <http://data.europa.eu/m8g/ContactPoint> ;
            sh:name "Has contact point in role" ;
            sh:path :hasContactPointInRole ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has title" ;
            sh:path :hasTitle ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnRole> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnRole> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#playedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#playedBy> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasContactPointInRole> ?that . ?that <http://data.europa.eu/a4g/ontology#hasContactPointInRole> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#contextualisedBy> ?that . ?that <http://data.europa.eu/a4g/ontology#contextualisedBy> ?this .}" ] ;
    sh:targetClass :AgentInRole .

:Contract a sh:NodeShape ;
    rdfs:label "Contract"@en ;
    rdfs:comment """A voluntary, deliberate, and legally binding agreement between two or more competent parties.

Additional information:

This includes concession contracts.

(WG approval 01/06/2018)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A voluntary, deliberate, and legally binding agreement between two or more competent parties.

Additional information:

This includes concession contracts.

(WG approval 01/06/2018)""" ;
    sh:name "Contract" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has contract conclusion date" ;
            sh:path :hasContractConclusionDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has access u r l" ;
            sh:path :hasAccessURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has estimated duration" ;
            sh:path :hasEstimatedDuration ],
        [ a sh:PropertyShape ;
            sh:class :ContractSignatory ;
            sh:name "Signed by signatory" ;
            sh:path :signedBySignatory ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Signed by signatory" ;
            sh:path :signedBySignatory ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Binds buyer" ;
            sh:path :bindsBuyer ],
        [ a sh:PropertyShape ;
            sh:class :Duration ;
            sh:name "Has estimated duration" ;
            sh:path :hasEstimatedDuration ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has access u r l" ;
            sh:path :hasAccessURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has entry into force date" ;
            sh:path :hasEntryIntoForceDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has entry into force date" ;
            sh:path :hasEntryIntoForceDate ],
        [ a sh:PropertyShape ;
            sh:class :Buyer ;
            sh:name "Binds buyer" ;
            sh:path :bindsBuyer ],
        [ a sh:PropertyShape ;
            sh:class :LotAwardOutcome ;
            sh:name "Results from lot award outcome" ;
            sh:path :resultsFromLotAwardOutcome ],
        [ a sh:PropertyShape ;
            sh:class :Tender ;
            sh:name "Includes tender" ;
            sh:path :includesTender ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has contract conclusion date" ;
            sh:path :hasContractConclusionDate ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Includes lot" ;
            sh:path :includesLot ],
        [ a sh:PropertyShape ;
            sh:class :Lot ;
            sh:name "Includes lot" ;
            sh:path :includesLot ],
        [ a sh:PropertyShape ;
            sh:class :Contractor ;
            sh:name "Binds contractor" ;
            sh:path :bindsContractor ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#includesTender> ?that . ?that <http://data.europa.eu/a4g/ontology#includesTender> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#signedBySignatory> ?that . ?that <http://data.europa.eu/a4g/ontology#signedBySignatory> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#bindsBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#bindsBuyer> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#includesLot> ?that . ?that <http://data.europa.eu/a4g/ontology#includesLot> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#bindsContractor> ?that . ?that <http://data.europa.eu/a4g/ontology#bindsContractor> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasEstimatedDuration> ?that . ?that <http://data.europa.eu/a4g/ontology#hasEstimatedDuration> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#resultsFromLotAwardOutcome> ?this .}" ] ;
    sh:targetClass :Contract .

:Document a sh:NodeShape ;
    rdfs:label "Document"@en ;
