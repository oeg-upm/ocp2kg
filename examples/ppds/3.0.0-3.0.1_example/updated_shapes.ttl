            sh:name "Depends on winner" ;
            sh:path :dependsOnWinner ],
        [ a sh:PropertyShape ;
            sh:class :Winner ;
            sh:name "Depends on winner" ;
            sh:path :dependsOnWinner ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnWinner> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnWinner> ?this .}" ] ;
    sh:targetClass :ContractorSideSignatory .

:ElementChangeDescription a sh:NodeShape ;
    rdfs:label "Element change description"@en ;
    rdfs:comment "Information about a specific field to be changed with regard to a previous notice."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "Information about a specific field to be changed with regard to a previous notice." ;
    sh:name "Element change description" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has previous version of element reference" ;
            sh:path :hasPreviousVersionOfElementReference ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has element reference" ;
            sh:path :hasElementReference ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has procurement document change date" ;
            sh:path :hasProcurementDocumentChangeDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is procurement document changed" ;
            sh:path :isProcurementDocumentChanged ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has procurement document change date" ;
            sh:path :hasProcurementDocumentChangeDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has element reference" ;
            sh:path :hasElementReference ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has change description" ;
            sh:path :hasChangeDescription ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has previous version of element reference" ;
            sh:path :hasPreviousVersionOfElementReference ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has change justification" ;
            sh:path :hasChangeJustification ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is procurement document changed" ;
            sh:path :isProcurementDocumentChanged ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has change reason description" ;
            sh:path :hasChangeReasonDescription ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasChangeJustification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasChangeJustification> ?this .}" ] ;
    sh:targetClass :ElementChangeDescription .

:ElementConfidentialityDescription a sh:NodeShape ;
    rdfs:label "Element confidentiality description"@en ;
    rdfs:comment """Information about a specific field not intended for publication. 

Additional Information:
In the model, a field is identified by a combination of a class and a property on that class. Therefore, these two references should be both provided."""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Information about a specific field not intended for publication. 

Additional Information:
In the model, a field is identified by a combination of a class and a property on that class. Therefore, these two references should be both provided.""" ;
    sh:name "Element confidentiality description" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has accessibility date" ;
            sh:path :hasAccessibilityDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has property reference" ;
            sh:path :hasPropertyReference ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has confidentiality justification" ;
            sh:path :hasConfidentialityJustification ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has class reference" ;
            sh:path :hasClassReference ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has non publication justification" ;
            sh:path :hasNonPublicationJustification ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has property reference" ;
            sh:path :hasPropertyReference ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has confidentiality justification" ;
            sh:path :hasConfidentialityJustification ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has accessibility date" ;
            sh:path :hasAccessibilityDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has class reference" ;
            sh:path :hasClassReference ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNonPublicationJustification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNonPublicationJustification> ?this .}" ] ;
    sh:targetClass :ElementConfidentialityDescription .

:ElementDescription a sh:NodeShape ;
    rdfs:label "Element description"@en ;
    rdfs:comment "Description about a specific resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "Description about a specific resource." ;
