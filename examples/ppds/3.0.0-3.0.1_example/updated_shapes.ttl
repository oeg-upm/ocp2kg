@prefix : <http://data.europa.eu/a4g/ontology#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:appliesRemedyType a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Review-remedy-type> ;
            sh:path <skos:inScheme> ] .

:hasAdditionalClassification a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Cpv> ;
            sh:path <skos:inScheme> ] .

:hasAdditionalContractNature a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Contract-nature> ;
            sh:path <skos:inScheme> ] .

:hasConfirmedIrregularityType a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Irregularity-type> ;
            sh:path <skos:inScheme> ] .

:hasItemCountryOfOrigin a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Country> ;
            sh:path <skos:inScheme> ] .

:hasLanguage a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Language> ;
            sh:path <skos:inScheme> ] .

:hasLegalRegime a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue :Legal-regime ;
            sh:path <skos:inScheme> ] .

:hasNationality a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Country> ;
            sh:path <skos:inScheme> ] .

:hasNonElectronicSubmissionJustification a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Communication-justification> ;
            sh:path <skos:inScheme> ] .

:hasPerformingStaffQualificationInformation a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Requirement-stage> ;
            sh:path <skos:inScheme> ] .

:hasReservedProcurement a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Reserved-procurement> ;
            sh:path <skos:inScheme> ] .

:hasReviewDecisionType a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Decision-type> ;
            sh:path <skos:inScheme> ] .

:hasSubcontractingObligation a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Subcontracting-obligation> ;
            sh:path <skos:inScheme> ] .

:hasTenderSubcontractingInformation a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Subcontracting-indication> ;
            sh:path <skos:inScheme> ] .

:hasThresholdType a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Number-threshold> ;
            sh:path <skos:inScheme> ] .

:hasUnofficialLanguage a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Language> ;
            sh:path <skos:inScheme> ] .

:includesAccessibilityCriterion a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Accessibility> ;
            sh:path <skos:inScheme> ] .

:requestsRemedyType a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            sh:hasValue <http://publications.europa.eu/resource/authority/Review-remedy-type> ;
            sh:path <skos:inScheme> ] .

<http://data.europa.eu/a4g/shape> a owl:Ontology ;
    rdfs:label "eProcurement datashapes"@en ;
    cc:attributionName "Publications Office of the European Union" ;
    cc:attributionURL <http://publications.europa.eu/resource/authority/corporate-body/PUBL> ;
    dc:contributor [ a foaf:Person ;
            foaf:homepage <http://costezki.ro> ;
            foaf:name "Eugeniu" ;
            foaf:surname "Costetchi" ;
            schema:affiliation [ foaf:name "Meaningfy" ;
                    foaf:page <http://meaningfy.ws> ] ],
        [ a foaf:Person ;
            foaf:name "Andreea" ;
            foaf:surname "Pasare" ;
            schema:affiliation [ foaf:name "Meaningfy" ;
                    foaf:page <http://meaningfy.ws> ] ],
        [ a foaf:Person ;
            foaf:name "Natalie" ;
            foaf:surname "Muric" ;
            schema:affiliation [ foaf:name "Publications Office of the European Union" ] ] ;
    dc:rights "This ontology is licenced under CC BY-SA 4.0 - http://creativecommons.org/licenses/by-sa/4.0/" ;
    dcterms:creator [ a foaf:Person ;
            foaf:name "eProcurement Ontology Working Group" ] ;
    dcterms:date "2022-07-29"^^xsd:date ;
    dcterms:description "This module provides the datashape definitions for the eProcurement ontology."@en ;
    dcterms:license <http://creativecommons.org/licenses/by-sa/4.0/> ;
    dcterms:title "eProcurement datashapes"@en ;
    vann:preferredNamespacePrefix "epo-shape" ;
    vann:preferredNamespaceUri "http://data.europa.eu/a4g/shape#" ;
    rdfs:comment "eProcurement core ontology version generated automatically from ePO_CM.xml on 29/07/2022" ;
    rdfs:seeAlso <https://docs.ted.europa.eu/EPO/dev/index.html>,
        <https://joinup.ec.europa.eu/collection/eprocurement/solution/eprocurement-ontology>,
        <https://op.europa.eu/en/web/eu-vocabularies/e-procurement> ;
    owl:imports <http://data.europa.eu/a4g/ontology>,
        <http://datashapes.org/dash>,
        dcterms:,
        <http://www.w3.org/2004/02/skos/core>,
        sh: ;
    owl:incompatibleWith "2.x.x" ;
    owl:versionIRI :version-3.0.0 ;
    owl:versionInfo "3.0.0" .

<http://myexampleuri.org/data#epo:ConcessionEstimateShape> a sh:NodeShape ;
    sh:targetClass <epo:ConcessionEstimate> .

<http://myexampleuri.org/data#epo:IndefiniteDurationShape> a sh:NodeShape ;
    sh:targetClass <epo:IndefiniteDuration> .

<http://myexampleuri.org/data#epo:SpecificDurationShape> a sh:NodeShape ;
    sh:targetClass <epo:SpecificDuration> .

:AccessTerm a sh:NodeShape ;
    rdfs:label "Access term"@en ;
    rdfs:comment """Conditions and stipulations about where and how to access the procurement documents.

WG Approval 09/03/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Conditions and stipulations about where and how to access the procurement documents.

WG Approval 09/03/2021""" ;
    sh:name "Access term" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines offline access provider" ;
            sh:path :definesOfflineAccessProvider ],
        [ a sh:PropertyShape ;
            sh:class :CatalogueProvider ;
            sh:name "Defines catalogue provider" ;
            sh:path :definesCatalogueProvider ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has document restriction justification" ;
            sh:path :hasDocumentRestrictionJustification ],
        [ a sh:PropertyShape ;
            sh:class :PlannedProcurementPart ;
            sh:name "Refers to planned part" ;
            sh:path :refersToPlannedPart ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Involves procurement document" ;
            sh:path :involvesProcurementDocument ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has public access u r l" ;
            sh:path :hasPublicAccessURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has public access u r l" ;
            sh:path :hasPublicAccessURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has restricted access u r l" ;
            sh:path :hasRestrictedAccessURL ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has additional information deadline" ;
            sh:path :hasAdditionalInformationDeadline ],
        [ a sh:PropertyShape ;
            sh:class :ProcurementDocument ;
            sh:name "Involves procurement document" ;
            sh:path :involvesProcurementDocument ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:dateTime ;
            sh:name "Has additional information deadline" ;
            sh:path :hasAdditionalInformationDeadline ],
        [ a sh:PropertyShape ;
            sh:class :CatalogueReceiver ;
            sh:name "Defines catalogue receiver" ;
            sh:path :definesCatalogueReceiver ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Defines procurement procedure information provider" ;
            sh:path :definesProcurementProcedureInformationProvider ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is procurement document restricted" ;
            sh:path :isProcurementDocumentRestricted ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:anyURI ;
            sh:name "Has restricted access u r l" ;
            sh:path :hasRestrictedAccessURL ],
        [ a sh:PropertyShape ;
            sh:class :ProcurementProcedureInformationProvider ;
            sh:name "Defines procurement procedure information provider" ;
            sh:path :definesProcurementProcedureInformationProvider ],
        [ a sh:PropertyShape ;
            sh:class :OfflineAccessProvider ;
            sh:name "Defines offline access provider" ;
            sh:path :definesOfflineAccessProvider ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is procurement document restricted" ;
            sh:path :isProcurementDocumentRestricted ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToPlannedPart> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToPlannedPart> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#involvesProcurementDocument> ?that . ?that <http://data.europa.eu/a4g/ontology#involvesProcurementDocument> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesOfflineAccessProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#definesOfflineAccessProvider> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesProcurementProcedureInformationProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#definesProcurementProcedureInformationProvider> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasDocumentRestrictionJustification> ?that . ?that <http://data.europa.eu/a4g/ontology#hasDocumentRestrictionJustification> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesCatalogueProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#definesCatalogueProvider> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#definesCatalogueReceiver> ?that . ?that <http://data.europa.eu/a4g/ontology#definesCatalogueReceiver> ?this .}" ] ;
    sh:targetClass :AccessTerm .

:AcquiringCentralPurchasingBody a sh:NodeShape ;
    rdfs:label "Acquiring central purchasing body"@en ;
    rdfs:comment """Role of an agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other buyers.
Additional Information:
In public procurement the role of Acquiring Central purchasing body is carried out by a Central Purchasing Body for other Contracting Authorities.

WG approval 05/08/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Role of an agent procuring activities conducted on a permanent basis in the form of the acquisition of supplies and/or services intended for other buyers.
Additional Information:
In public procurement the role of Acquiring Central purchasing body is carried out by a Central Purchasing Body for other Contracting Authorities.

WG approval 05/08/2021""" ;
    sh:name "Acquiring central purchasing body" ;
    sh:targetClass :AcquiringCentralPurchasingBody .

:AwardDecision a sh:NodeShape ;
    rdfs:label "Award decision"@en ;
    rdfs:comment """Resolution of the buyer as to the result of the procurement procedure.

(WG approval 14/11/2018)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Resolution of the buyer as to the result of the procurement procedure.

(WG approval 14/11/2018)""" ;
    sh:name "Award decision" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :LotAwardOutcome ;
            sh:name "Comprises lot award outcome" ;
            sh:path :comprisesLotAwardOutcome ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Comprises lot award outcome" ;
            sh:path :comprisesLotAwardOutcome ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#comprisesLotAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#comprisesLotAwardOutcome> ?this .}" ] ;
    sh:targetClass :AwardDecision .

:AwardEvaluationTerm a sh:NodeShape ;
    rdfs:label "Award evaluation term"@en ;
    rdfs:comment "Conditions and stipulations defining particularities of the evaluation of award criteria."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "Conditions and stipulations defining particularities of the evaluation of award criteria." ;
    sh:name "Award evaluation term" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has overall price award criteria ponderation" ;
            sh:path :hasOverallPriceAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has overall quality award criteria ponderation" ;
            sh:path :hasOverallQualityAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:name "Has overall quality award criteria ponderation" ;
            sh:path :hasOverallQualityAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has award criteria order justification" ;
            sh:path :hasAwardCriteriaOrderJustification ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has overall cost award criteria ponderation" ;
            sh:path :hasOverallCostAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has award criteria order justification" ;
            sh:path :hasAwardCriteriaOrderJustification ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:name "Has overall price award criteria ponderation" ;
            sh:path :hasOverallPriceAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:name "Has overall cost award criteria ponderation" ;
            sh:path :hasOverallCostAwardCriteriaPonderation ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has award criteria evaluation formula" ;
            sh:path :hasAwardCriteriaEvaluationFormula ] ;
    sh:targetClass :AwardEvaluationTerm .

:AwardingCentralPurchasingBody a sh:NodeShape ;
    rdfs:label "Awarding central purchasing body"@en ;
    rdfs:comment """Role of an agent procuring activities conducted on a permanent basis in the form of the award of public contracts or the conclusion of framework agreements for works, supplies or services intended for other buyers.
Additional Information:
In public procurement the role of Awarding Central purchasing body is carried out by a Central Purchasing Body for other Contracting Authorities.

WG approval 05/08/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Role of an agent procuring activities conducted on a permanent basis in the form of the award of public contracts or the conclusion of framework agreements for works, supplies or services intended for other buyers.
Additional Information:
In public procurement the role of Awarding Central purchasing body is carried out by a Central Purchasing Body for other Contracting Authorities.

WG approval 05/08/2021""" ;
    sh:name "Awarding central purchasing body" ;
    sh:targetClass :AwardingCentralPurchasingBody .

:BuyerSideSignatory a sh:NodeShape ;
    rdfs:label "Buyer side signatory"@en ;
    rdfs:comment "A role of an agent who signs the contract for the buyer."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "A role of an agent who signs the contract for the buyer." ;
    sh:name "Buyer side signatory" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ],
        [ a sh:PropertyShape ;
            sh:class :Buyer ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?this .}" ] ;
    sh:targetClass :BuyerSideSignatory .

:CentralPurchasingBody a sh:NodeShape ;
    rdfs:label "Central purchasing body"@en ;
    rdfs:comment """Role of an agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other buyers.

Additional Information:
In public procurement the role of Central purchasing body is carried out by a Contracting Authority for other Contracting Authorities.
Contracting authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of public contracts or the conclusion of framework agreements for works, supplies or services intended for contracting authorities;

WG approval 05/08/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Role of an agent that provides centralised purchasing activities and, possibly, ancillary purchasing activities for other buyers.

Additional Information:
In public procurement the role of Central purchasing body is carried out by a Contracting Authority for other Contracting Authorities.
Contracting authority procuring activities conducted on a permanent basis, in one of the following forms:[...](b) the award of public contracts or the conclusion of framework agreements for works, supplies or services intended for contracting authorities;

WG approval 05/08/2021""" ;
    sh:name "Central purchasing body" ;
    sh:targetClass :CentralPurchasingBody .

:CompetitionNotice a sh:NodeShape ;
    rdfs:label "Competition notice"@en ;
    rdfs:comment """An announcement of the launch of a procurement procedure by a procuring entity.

(WG approval 18/05/2018)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """An announcement of the launch of a procurement procedure by a procuring entity.

(WG approval 18/05/2018)""" ;
    sh:name "Competition notice" ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Announces role" ;
            sh:path :announcesRole ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Announces procedure" ;
            sh:path :announcesProcedure ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Announces lot" ;
            sh:path :announcesLot ],
        <http://myexampleuri.org/data#announcesLotGroupShape>,
        <http://myexampleuri.org/data#announcesLotShape>,
        <http://myexampleuri.org/data#announcesProcedureShape>,
        <http://myexampleuri.org/data#announcesRoleShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesRole> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesRole> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesLot> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesLot> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesLotGroup> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesLotGroup> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesProcedure> ?this .}" ] ;
    sh:targetClass :CompetitionNotice .

:CompletionNotice a sh:NodeShape ;
    rdfs:label "Completion notice"@en ;
    rdfs:comment "An announcement of the end of a procurement by a buyer."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "An announcement of the end of a procurement by a buyer." ;
    sh:name "Completion notice" ;
    sh:targetClass :CompletionNotice .

:ConcessionContract a sh:NodeShape ;
    rdfs:label "Concession contract"@en ;
    rdfs:comment """A contract between one or more buyers and one or more economic operators giving the right to the economic operators to exploit the rights foreseen in the contract which may include the receipt of payments.

WG Approval 24/05/2022"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A contract between one or more buyers and one or more economic operators giving the right to the economic operators to exploit the rights foreseen in the contract which may include the receipt of payments.

WG Approval 24/05/2022""" ;
    sh:name "Concession contract" ;
    sh:targetClass :ConcessionContract .

:ContextSpecificDescription a sh:NodeShape ;
    rdfs:label "Context specific description"@en ;
    rdfs:comment """A description concerning a procurement object or a notice in a specific situation context. 

Additional Information:
The description has its own identity (+I) but is dependent (+D) on the concerned entity. 

We say that ContextSpecificDescription *concerns* an entity."""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A description concerning a procurement object or a notice in a specific situation context. 

Additional Information:
The description has its own identity (+I) but is dependent (+D) on the concerned entity. 

We say that ContextSpecificDescription *concerns* an entity.""" ;
    sh:name "Context specific description" ;
    sh:targetClass :ContextSpecificDescription .

:ContextualProjection a sh:NodeShape ;
    rdfs:label "Contextual projection"@en ;
    rdfs:comment """Projection of an entity and all of its properties that hold in a given situation context. 

Additional Information:
The contextual projection does not have its own identity (-I), is dependent  (+D) on the described entity, and is anti-rigid (~R)

We say that ContextualProjection *describes* an entity.

Adaptation of ContextSlices pattern encoding a 4D view.
http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Projection of an entity and all of its properties that hold in a given situation context. 

Additional Information:
The contextual projection does not have its own identity (-I), is dependent  (+D) on the described entity, and is anti-rigid (~R)

We say that ContextualProjection *describes* an entity.

Adaptation of ContextSlices pattern encoding a 4D view.
http://ontologydesignpatterns.org/wiki/Submissions:Context_Slices""" ;
    sh:name "Contextual projection" ;
    sh:targetClass :ContextualProjection .

:ContractLotCompletionInformation a sh:NodeShape ;
    rdfs:label "Contract lot completion information"@en ;
    rdfs:comment "Information related to a given Lot at the end of the procurement."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "Information related to a given Lot at the end of the procurement." ;
    sh:name "Contract lot completion information" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :MonetaryValue ;
            sh:name "Has payment value" ;
            sh:path :hasPaymentValue ],
        [ a sh:PropertyShape ;
            sh:class :Lot ;
            sh:name "Describes lot completion" ;
            sh:path :describesLotCompletion ],
        [ a sh:PropertyShape ;
            sh:class :Contract ;
            sh:name "Refers to contract" ;
            sh:path :refersToContract ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has payment value" ;
            sh:path :hasPaymentValue ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Refers to contract" ;
            sh:path :refersToContract ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Describes lot completion" ;
            sh:path :describesLotCompletion ],
