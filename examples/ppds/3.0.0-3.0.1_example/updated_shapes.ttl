        <http://myexampleuri.org/data#isBasedOnImplementingRegulationShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasOfficialLanguage> ?that . ?that <http://data.europa.eu/a4g/ontology#hasOfficialLanguage> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasUUID> ?that . ?that <http://data.europa.eu/a4g/ontology#hasUUID> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasUnofficialLanguage> ?that . ?that <http://data.europa.eu/a4g/ontology#hasUnofficialLanguage> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToPrevious> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToPrevious> ?this .}" ],
