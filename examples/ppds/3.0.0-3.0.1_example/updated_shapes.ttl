<http://data.europa.eu/m8g/Constraint> a sh:NodeShape ;
    rdfs:label "Constraint"@en ;
    rdfs:comment """Limitation applied to an Information Concept.

Additional Information:
Constraints are requirements in themselves, since they impose prerequisites which influence the definition, use and/or fulfilment of the requirement. They represent hard conditions such as minimum or maximum expressions which can be used to evaluate pieces of information, the required age, income, involvement in activities, etc. An example from the eProcurement domain is a threshold as the minimum turnover required by the buying organisation to select the candidates. Note that CCCEV does not provide any specific guidance on when which kind of Requirement should be used. Users of this vocabulary should make decisions on this topic in their specific context."""@en ;
    sh:description """Limitation applied to an Information Concept.

Additional Information:
Constraints are requirements in themselves, since they impose prerequisites which influence the definition, use and/or fulfilment of the requirement. They represent hard conditions such as minimum or maximum expressions which can be used to evaluate pieces of information, the required age, income, involvement in activities, etc. An example from the eProcurement domain is a threshold as the minimum turnover required by the buying organisation to select the candidates. Note that CCCEV does not provide any specific guidance on when which kind of Requirement should be used. Users of this vocabulary should make decisions on this topic in their specific context.""" ;
    sh:name "Constraint" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:decimal ;
            sh:name "Has threshold value" ;
            sh:path :hasThresholdValue ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has threshold value" ;
            sh:path :hasThresholdValue ],
        [ a sh:PropertyShape ;
            sh:class <http://data.europa.eu/m8g/InformationConcept> ;
            sh:name "Constrains" ;
            sh:path :constrains ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#constrains> ?that . ?that <http://data.europa.eu/a4g/ontology#constrains> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasThresholdType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasThresholdType> ?this .}" ] ;
    sh:targetClass <http://data.europa.eu/m8g/Constraint> .

<http://data.europa.eu/m8g/Person> a sh:NodeShape ;
    rdfs:label "Person"@en ;
