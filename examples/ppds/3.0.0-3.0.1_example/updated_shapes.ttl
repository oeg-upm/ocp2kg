        [ a sh:PropertyShape ;
            sh:class :ReviewRequest ;
            sh:name "Resolves review request" ;
            sh:path :resolvesReviewRequest ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#resolvesReviewRequest> ?that . ?that <http://data.europa.eu/a4g/ontology#resolvesReviewRequest> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasReviewDecisionType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasReviewDecisionType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#appliesRemedyType> ?that . ?that <http://data.europa.eu/a4g/ontology#appliesRemedyType> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType> ?that . ?that <http://data.europa.eu/a4g/ontology#hasConfirmedIrregularityType> ?this .}" ] ;
    sh:targetClass :ReviewDecision .

:ReviewRequestSummary a sh:NodeShape ;
    rdfs:label "Review request summary"@en ;
    rdfs:comment """Summary information about the requests the buyer received to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests.

Additional information:
This class corresponds  in eForms to BG-612     Buyer Review Summary."""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Summary information about the requests the buyer received to review any of its decisions (e.g. the technical specifications, award decision), as set out in Art. 1(5) of Directive 89/665/EEC and Directive 92/13/EEC, and about the complainants that submitted the requests.

Additional information:
This class corresponds  in eForms to BG-612     Buyer Review Summary.""" ;
    sh:name "Review request summary" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Concerns review summary for lot" ;
            sh:path :concernsReviewSummaryForLot ],
        [ a sh:PropertyShape ;
            sh:class :Lot ;
            sh:name "Concerns review summary for lot" ;
            sh:path :concernsReviewSummaryForLot ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:name "Has total number of complainants" ;
            sh:path :hasTotalNumberOfComplainants ],
        [ a sh:PropertyShape ;
            sh:class :ReviewIrregularitySummary ;
            sh:name "Has review irregularity summary" ;
            sh:path :hasReviewIrregularitySummary ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has total number of complainants" ;
            sh:path :hasTotalNumberOfComplainants ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasReviewIrregularitySummary> ?that . ?that <http://data.europa.eu/a4g/ontology#hasReviewIrregularitySummary> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#concernsReviewSummaryForLot> ?that . ?that <http://data.europa.eu/a4g/ontology#concernsReviewSummaryForLot> ?this .}" ] ;
    sh:targetClass :ReviewRequestSummary .

