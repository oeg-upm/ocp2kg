            sh:path :hasFinancialOfferValue ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is variant" ;
            sh:path :isVariant ],
        [ a sh:PropertyShape ;
            sh:class :Subcontractor ;
            sh:name "Specifies subcontractors" ;
            sh:path :specifiesSubcontractors ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Has electronic submission" ;
            sh:path :hasElectronicSubmission ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has calculation method" ;
            sh:path :hasCalculationMethod ],
        [ a sh:PropertyShape ;
            sh:class :MonetaryValue ;
            sh:name "Has estimated buyer concession revenue" ;
            sh:path :hasEstimatedBuyerConcessionRevenue ],
