    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#describesTender> ?that . ?that <http://data.europa.eu/a4g/ontology#describesTender> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#awardsLotToWinner> ?that . ?that <http://data.europa.eu/a4g/ontology#awardsLotToWinner> ?this .}" ] ;
    sh:targetClass :TenderAwardOutcome .

