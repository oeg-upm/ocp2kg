        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnServiceProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnServiceProvider> ?this .}" ] ;
