            sh:name "Place of birth" ;
            sh:path :placeOfBirth ],
        [ a sh:PropertyShape ;
            sh:class :Business ;
            sh:name "Is beneficial owner of" ;
            sh:path :isBeneficialOwnerOf ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Death date" ;
            sh:path <http://unknown.domain/for/prefix#deathDate> ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Alternative" ;
            sh:path dcterms:alternative ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Given name" ;
            sh:path foaf:givenName ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Death date" ;
            sh:path <http://unknown.domain/for/prefix#deathDate> ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Family name" ;
            sh:path foaf:familyName ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Registered address" ;
            sh:path :registeredAddress ],
        [ a sh:PropertyShape ;
            sh:class dcterms:Location ;
            sh:name "Place of death" ;
            sh:path :placeOfDeath ],
        [ a sh:PropertyShape ;
            sh:class <http://www.w3.org/ns/locn#Address> ;
            sh:name "Registered address" ;
            sh:path :registeredAddress ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Place of birth" ;
            sh:path :placeOfBirth ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Place of death" ;
            sh:path :placeOfDeath ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Patronymic name" ;
            sh:path <http://unknown.domain/for/prefix#patronymicName> ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has country of birth" ;
            sh:path :hasCountryOfBirth ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Name" ;
            sh:path foaf:name ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Birth date" ;
            sh:path <http://unknown.domain/for/prefix#birthDate> ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Birth name" ;
            sh:path <http://unknown.domain/for/prefix#birthName> ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isBeneficialOwnerOf> ?that . ?that <http://data.europa.eu/a4g/ontology#isBeneficialOwnerOf> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#placeOfDeath> ?that . ?that <http://data.europa.eu/a4g/ontology#placeOfDeath> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasCountryOfBirth> ?that . ?that <http://data.europa.eu/a4g/ontology#hasCountryOfBirth> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#registeredAddress> ?that . ?that <http://data.europa.eu/a4g/ontology#registeredAddress> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasNationality> ?that . ?that <http://data.europa.eu/a4g/ontology#hasNationality> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#placeOfBirth> ?that . ?that <http://data.europa.eu/a4g/ontology#placeOfBirth> ?this .}" ] ;
    sh:targetClass <http://data.europa.eu/m8g/Person> .

<http://myexampleuri.org/data#announcesProcedureShape> sh:class :Procedure ;
