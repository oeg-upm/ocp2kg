    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:name "Has maximum number of candidates" ;
            sh:path :hasMaximumNumberOfCandidates ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Has successive reduction" ;
            sh:path :hasSuccessiveReduction ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has maximum number of candidates" ;
            sh:path :hasMaximumNumberOfCandidates ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Has no negotiation necessary" ;
            sh:path :hasNoNegotiationNecessary ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has no negotiation necessary" ;
            sh:path :hasNoNegotiationNecessary ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:integer ;
            sh:name "Has minimum number of candidates" ;
            sh:path :hasMinimumNumberOfCandidates ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has estimated invitation to tender date" ;
            sh:path :hasEstimatedInvitationToTenderDate ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:date ;
            sh:name "Has estimated invitation to express interest date" ;
            sh:path :hasEstimatedInvitationToExpressInterestDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has minimum number of candidates" ;
            sh:path :hasMinimumNumberOfCandidates ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has estimated invitation to express interest date" ;
            sh:path :hasEstimatedInvitationToExpressInterestDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has estimated invitation to tender date" ;
            sh:path :hasEstimatedInvitationToTenderDate ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
