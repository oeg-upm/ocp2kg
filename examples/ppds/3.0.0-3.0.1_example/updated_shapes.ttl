    sh:description """An announcement of the award or non-award of a contract by a buyer.

(WG approval 27/03/2019)""" ;
    sh:name "Result notice" ;
    sh:property [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Refers to lot" ;
            sh:path :refersToLot ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Announces contract" ;
            sh:path :announcesContract ],
        [ a sh:PropertyShape ;
            sh:class :Procedure ;
            sh:name "Refers to procedure" ;
            sh:path :refersToProcedure ],
        [ a sh:PropertyShape ;
            sh:minCount 1 ;
            sh:name "Refers to role" ;
            sh:path :refersToRole ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Refers to procedure" ;
            sh:path :refersToProcedure ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Refers to procedure term" ;
            sh:path :refersToProcedureTerm ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Refers to review term" ;
            sh:path :refersToReviewTerm ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Announces notice award information" ;
            sh:path :announcesNoticeAwardInformation ],
        <http://myexampleuri.org/data#announcesContractShape>,
        <http://myexampleuri.org/data#announcesLotAwardOutcomeShape>,
        <http://myexampleuri.org/data#announcesLotGroupAwardInformationShape>,
        <http://myexampleuri.org/data#announcesNonPublishedElementShape>,
        <http://myexampleuri.org/data#announcesNoticeAwardInformationShape>,
        <http://myexampleuri.org/data#announcesRoleShape>,
        <http://myexampleuri.org/data#announcesTenderShape>,
        <http://myexampleuri.org/data#refersToLotGroupShape>,
        <http://myexampleuri.org/data#refersToLotShape>,
        <http://myexampleuri.org/data#refersToProcedureTermShape>,
        <http://myexampleuri.org/data#refersToReviewTermShape>,
        <http://myexampleuri.org/data#refersToRoleShape> ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToReviewTerm> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToReviewTerm> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesLotAwardOutcome> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesLotAwardOutcome> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesNonPublishedElement> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesNonPublishedElement> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesContract> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesContract> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToProcedureTerm> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToProcedureTerm> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesNoticeAwardInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesNoticeAwardInformation> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToLot> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToLot> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToRole> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToRole> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesTender> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesTender> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToProcedure> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToProcedure> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#refersToLotGroup> ?that . ?that <http://data.europa.eu/a4g/ontology#refersToLotGroup> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesRole> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesRole> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#announcesLotGroupAwardInformation> ?that . ?that <http://data.europa.eu/a4g/ontology#announcesLotGroupAwardInformation> ?this .}" ] ;
    sh:targetClass :ResultNotice .

