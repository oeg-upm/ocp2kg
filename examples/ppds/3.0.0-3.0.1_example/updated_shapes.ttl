    sh:targetClass :Duration,
        :SpecificDuration .

:PlannedProcurementPart a sh:NodeShape ;
    rdfs:label "Planned procurement part"@en ;
    rdfs:comment """A subdivision of a planned procurement that may later become one or more lots or a self-standing procedure. A lot or a procedure can also cover one or more parts of the planned procurement.

WG Approval 20/06/2019"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A subdivision of a planned procurement that may later become one or more lots or a self-standing procedure. A lot or a procedure can also cover one or more parts of the planned procurement.

WG Approval 20/06/2019""" ;
    sh:name "Planned procurement part" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is using e u funds" ;
            sh:path :isUsingEUFunds ],
        [ a sh:PropertyShape ;
            sh:class :Duration ;
            sh:name "Has planned duration" ;
            sh:path :hasPlannedDuration ],
        [ a sh:PropertyShape ;
            sh:class :ProcessPlanningTerm ;
            sh:name "Is subject to planning term" ;
            sh:path :isSubjectToPlanningTerm ],
        [ a sh:PropertyShape ;
            sh:datatype xsd:boolean ;
            sh:name "Is s m e suitable" ;
            sh:path :isSMESuitable ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has additional information" ;
            sh:path :hasAdditionalInformation ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Is s m e suitable" ;
            sh:path :isSMESuitable ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has purpose" ;
            sh:path :hasPurpose ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has planned duration" ;
            sh:path :hasPlannedDuration ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Is using e u funds" ;
            sh:path :isUsingEUFunds ],
        [ a sh:PropertyShape ;
            sh:class :Period ;
            sh:name "Has planned period" ;
            sh:path :hasPlannedPeriod ],
        [ a sh:PropertyShape ;
            sh:class :TechniqueUsage ;
            sh:name "Foresees technique" ;
            sh:path :foreseesTechnique ],
        [ a sh:PropertyShape ;
            sh:class <http://unknown.domain/for/prefix#Channel> ;
            sh:name "Uses channel" ;
            sh:path :usesChannel ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has planned period" ;
            sh:path :hasPlannedPeriod ],
        [ a sh:PropertyShape ;
            sh:class :Purpose ;
            sh:name "Has purpose" ;
            sh:path :hasPurpose ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPlannedPeriod> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPlannedPeriod> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#foreseesTechnique> ?that . ?that <http://data.europa.eu/a4g/ontology#foreseesTechnique> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPurpose> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPurpose> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasLegalBasis> ?that . ?that <http://data.europa.eu/a4g/ontology#hasLegalBasis> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#usesChannel> ?that . ?that <http://data.europa.eu/a4g/ontology#usesChannel> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#isSubjectToPlanningTerm> ?that . ?that <http://data.europa.eu/a4g/ontology#isSubjectToPlanningTerm> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasPlannedDuration> ?that . ?that <http://data.europa.eu/a4g/ontology#hasPlannedDuration> ?this .}" ] ;
    sh:targetClass :PlannedProcurementPart .

:Tender a sh:NodeShape ;
    rdfs:label "Tender"@en ;
    rdfs:comment """Information submitted by the economic operator to specify its offer regarding a specific lot, in response to the call for tender.

(WG approval 03/05/2022)"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """Information submitted by the economic operator to specify its offer regarding a specific lot, in response to the call for tender.

(WG approval 03/05/2022)""" ;
    sh:name "Tender" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
