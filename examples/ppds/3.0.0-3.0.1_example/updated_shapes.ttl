    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#hasDPSScope> ?that . ?that <http://data.europa.eu/a4g/ontology#hasDPSScope> ?this .}" ] ;
    sh:targetClass :DynamicPurchaseSystemTechniqueUsage .

:EAuctionTechniqueUsage a sh:NodeShape ;
