        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has internet address" ;
            sh:path :hasInternetAddress ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Has contact name" ;
            sh:path :hasContactName ],
        [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has description" ;
