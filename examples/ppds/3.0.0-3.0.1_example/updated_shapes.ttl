:Awarder a sh:NodeShape ;
    rdfs:label "Awarder"@en ;
    rdfs:comment "Organisation that signs the award decision."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "Organisation that signs the award decision." ;
    sh:name "Awarder" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :Buyer ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?this .}" ] ;
    sh:targetClass :Awarder .

:BudgetProvider a sh:NodeShape ;
    rdfs:label "Budget provider"@en ;
    rdfs:comment "A role of an agent whose budget is used to pay for the contract."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "A role of an agent whose budget is used to pay for the contract." ;
    sh:name "Budget provider" ;
    sh:property [ a sh:PropertyShape ;
            sh:class :ProcurementServiceProvider ;
            sh:name "Depends on service provider" ;
            sh:path :dependsOnServiceProvider ],
        [ a sh:PropertyShape ;
            sh:class :Buyer ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on service provider" ;
            sh:path :dependsOnServiceProvider ],
        [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on buyer" ;
            sh:path :dependsOnBuyer ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnServiceProvider> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnServiceProvider> ?this .}" ],
        [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnBuyer> ?this .}" ] ;
    sh:targetClass :BudgetProvider .

:CatalogueProvider a sh:NodeShape ;
    rdfs:label "Catalogue provider"@en ;
    rdfs:comment """A role of an agent compiling and supplying a catalogue.

Additional Information:

The catalogue provider role is usually played by the agent that acts as a seller, or by another agent that acts on behalf of the seller.

WG Approval 28/01/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A role of an agent compiling and supplying a catalogue.

Additional Information:

The catalogue provider role is usually played by the agent that acts as a seller, or by another agent that acts on behalf of the seller.

WG Approval 28/01/2021""" ;
    sh:name "Catalogue provider" ;
    sh:targetClass :CatalogueProvider .

:CatalogueReceiver a sh:NodeShape ;
    rdfs:label "Catalogue receiver"@en ;
    rdfs:comment """A role of an agent processing a catalogue.

Additional Information:
The catalogue receiver may not only receive it but also validate it, process it, etc.

The catalogue receiver role is usually played by the agent that acts as a buyer, or by another agent that acts on behalf of the buyer.

WG Approval 28/01/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """A role of an agent processing a catalogue.

Additional Information:
The catalogue receiver may not only receive it but also validate it, process it, etc.

The catalogue receiver role is usually played by the agent that acts as a buyer, or by another agent that acts on behalf of the buyer.

WG Approval 28/01/2021""" ;
    sh:name "Catalogue receiver" ;
    sh:targetClass :CatalogueReceiver .

:ContractSignatory a sh:NodeShape ;
    rdfs:label "Contract signatory"@en ;
    rdfs:comment "A role of an agent who signs the contract."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "A role of an agent who signs the contract." ;
    sh:name "Contract signatory" ;
    sh:targetClass :ContractSignatory .

:Contractor a sh:NodeShape ;
    rdfs:label "Contractor"@en ;
    rdfs:comment """An economic operator that has signed a contract with a purchaser.
WG approval 13/04/2021"""@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description """An economic operator that has signed a contract with a purchaser.
WG approval 13/04/2021""" ;
    sh:name "Contractor" ;
    sh:property [ a sh:PropertyShape ;
            sh:maxCount 1 ;
            sh:name "Depends on contractor side signatory" ;
            sh:path :dependsOnContractorSideSignatory ],
        [ a sh:PropertyShape ;
            sh:class :ContractorSideSignatory ;
            sh:name "Depends on contractor side signatory" ;
            sh:path :dependsOnContractorSideSignatory ] ;
    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#dependsOnContractorSideSignatory> ?that . ?that <http://data.europa.eu/a4g/ontology#dependsOnContractorSideSignatory> ?this .}" ] ;
    sh:targetClass :Contractor .

:ContractorSideSignatory a sh:NodeShape ;
    rdfs:label "Contractor side signatory"@en ;
    rdfs:comment "A role of an agent who signs the contract for the contractor."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/a4g/ontology> ;
    sh:description "A role of an agent who signs the contract for the contractor." ;
    sh:name "Contractor side signatory" ;
    sh:property [ a sh:PropertyShape ;
