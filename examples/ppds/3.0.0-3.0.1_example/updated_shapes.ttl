    sh:sparql [ sh:select "SELECT ?this ?that WHERE { ?this <http://data.europa.eu/a4g/ontology#address> ?that . ?that <http://data.europa.eu/a4g/ontology#address> ?this .}" ] ;
    sh:targetClass <http://data.europa.eu/m8g/ContactPoint> .

<http://data.europa.eu/m8g/InformationConcept> a sh:NodeShape ;
    rdfs:label "Information concept"@en ;
    rdfs:comment "Piece of information that the Evidence provides or the Requirement needs."@en ;
    sh:description "Piece of information that the Evidence provides or the Requirement needs." ;
    sh:name "Information concept" ;
    sh:property [ a sh:PropertyShape ;
            sh:datatype rdfs:Literal ;
            sh:name "Has name" ;
            sh:path :hasName ],
        [ a sh:PropertyShape ;
