@prefix emo-resource: <https://w3id.org/citius-kg/emofinder/resource/>.
@prefix emolex: <https://w3id.org/def/emolex#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#>.
@prefix rb: <https://w3id.org/riverbench/schema/metadata#>.
@prefix bibo: <http://purl.org/ontology/bibo/>.
@prefix lexinfo: <http://www.lexinfo.net/ontology/3.0/lexinfo#>.
@prefix lime: <http://www.w3.org/ns/lemon/lime#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix vartrans: <http://www.w3.org/ns/lemon/vartrans#>.
@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix schema: <http://schema.org/>.
@prefix formats: <http://www.w3.org/ns/formats/>.
@prefix comp: <http://semweb.mmlab.be/ns/rml-compression#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#>.
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#>.
@base <http://example.com/ns#>.
@prefix ex: <http://example.org/>.

ex:amusement_0 a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "hinojosa_2024.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://w3id.org/citius-kg/emofinder/resource/annotation/discreteEmotionalCategory/amusement/hinojosa_2024/{palabra_noaccents}";
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdf:type;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant emolex:Annotation;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant emolex:DiscreteEmotionalCategory;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant emolex:Amusement;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rdfs:label;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "palabra";
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant dcterms:source;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:constant <https://w3id.org/citius-kg/emofinder/resource/lexicon/hinojosa_2024>;
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant emolex:affects;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rr:template "https://w3id.org/citius-kg/emofinder/resource/lexical_entry/hinojosa_2024/{palabra_noaccents}";
			rr:termType rr:IRI
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rb:mean;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "mean_amusement";
			rr:datatype xsd:float
		];
	];
	rr:predicateObjectMap [
		rr:predicateMap [
			a rr:PredicateMap;
			rr:constant rb:standardDeviation;
		];
		rr:objectMap [
			a rr:ObjectMap;
			rml:reference "sd_amusement";
			rr:datatype xsd:float
		];
	].


